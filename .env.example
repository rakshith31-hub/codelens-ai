# Choose ONE LLM provider
LLM_PROVIDER=openai            # openai | anthropic
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=gpt-4o-mini           # or claude-haiku-4-5-20251001 if using anthropic

# Neo4j (graph db) - matches docker-compose defaults, change if deploying elsewhere
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=autodocs_pw

# Chroma (vector db) persistence path inside the container
CHROMA_PERSIST_DIR=/data/chroma
